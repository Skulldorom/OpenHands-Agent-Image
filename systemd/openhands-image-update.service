[Unit]
Description=Stage validated OpenHands image (no deployment)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/openhands-image-update/update-image.sh check
StateDirectory=openhands-image-update
UMask=0077
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openhands-image-update
